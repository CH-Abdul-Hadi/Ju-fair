# Web3Forms API key — get yours free at https://web3forms.com
# Enter the email address you want to receive form submissions on,
# then copy the Access Key they email you and paste it below.
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# Amap (高德地图) JS API Key — get yours at https://lbs.amap.com (Used as primary map service when provided)
VITE_AMAP_KEY=your_amap_js_api_key_here

# Google Maps API Key — optional fallback if AMap key is not provided
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ── Search-engine site verification (optional) ──────────────────────────────
# Paste JUST the token, not the whole <meta> tag. These are not secrets — they
# are meant to be publicly visible in the page source; that is how verification
# works. Each emits nothing while blank. See src/lib/verification.ts
VITE_GOOGLE_VERIFICATION=
VITE_BING_VERIFICATION=
VITE_BAIDU_VERIFICATION=
VITE_YANDEX_VERIFICATION=

# ── Analytics (optional, cookieless — no consent banner required) ───────────
# Set ONE of these. /privacy updates its own wording automatically to match,
# so enabling analytics cannot leave the published policy false.
# Cloudflare: dashboard -> Web Analytics -> add site -> copy the `token` value.
VITE_CF_ANALYTICS_TOKEN=
# Plausible: the domain exactly as configured in Plausible.
VITE_PLAUSIBLE_DOMAIN=
